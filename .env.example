# Session signing key (generate a secure 64-char hex string for production)
SESSION_SECRET=

# Optional administrator passcode override (leave blank in dev to use the first-run claim flow)
ADMIN_BOOTSTRAP_PASSCODE=

# Cloudflare Turnstile Keys (optional in dev; required for production spam protection)
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Application URL
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional AI Studio environment secret
GEMINI_API_KEY="MY_GEMINI_API_KEY"
